{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "extensions/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts"
  ]
}
